<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JJ Virtual Betting Arena</title>
    <style>
        body { background-color: #0f172a; color: #fff; font-family: Arial, sans-serif; margin: 0; padding: 20px; }
        .container { max-width: 500px; margin: auto; }
        .navbar { display: flex; justify-content: space-around; background: #1e293b; padding: 10px; border-radius: 8px; margin-bottom: 20px; }
        .navbar button { background: none; border: none; color: #94a3b8; font-weight: bold; cursor: pointer; padding: 10px; font-size: 14px; }
        .navbar button.active { color: #38bdf8; border-bottom: 2px solid #38bdf8; }
        .card { background: #1e293b; padding: 20px; border-radius: 8px; margin-bottom: 15px; }
        input, select { width: 100%; padding: 12px; margin: 8px 0; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 6px; box-sizing: border-box; }
        button.action-btn { width: 100%; padding: 12px; background: #22c55e; border: none; color: #fff; font-weight: bold; border-radius: 6px; cursor: pointer; margin-top: 10px; }
        button.action-btn:hover { background: #16a34a; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
    </style>
</head>
<body>

<div class="container">
    <h2 style="text-align: center;">Virtual Betting Arena</h2>

    <!-- Navigation Tabs -->
    <div class="navbar">
        <button onclick="switchTab('game')" id="btn-game" class="active">Game Lobby</button>
        <button onclick="switchTab('deposit')" id="btn-deposit">Deposit</button>
        <button onclick="switchTab('withdraw')" id="btn-withdraw">Withdraw</button>
    </div>

    <!-- Persistent Balance Display -->
    <div class="card" style="text-align: center;">
        <h4>Account Balance</h4>
        <h2 id="account-balance" style="color: #38bdf8; margin: 5px 0;">UGX 0.00</h2>
    </div>

    <!-- Tab 1: Game Lobby -->
    <div id="tab-game" class="tab-content active">
        <div class="card">
            <h3>Virtual Football Match</h3>
            <p>Match: Team A vs Team B</p>
            <p>Odds: Home (1.95) | Draw (3.20) | Away (2.10)</p>
            <button class="action-btn" onclick="alert('Place bet feature coming up!')">Place Bet (UGX 1,000)</button>
        </div>
    </div>

    <!-- Tab 2: Deposit Section -->
    <div id="tab-deposit" class="tab-content">
        <div class="card">
            <h3>Instant Mobile Money Deposit</h3>
            <input type="text" id="deposit-phone" placeholder="Phone (e.g. 256771234567)">
            <select id="deposit-network">
                <option value="MTN">MTN MoMo</option>
                <option value="Airtel">Airtel Money</option>
            </select>
            <input type="number" id="deposit-amount" placeholder="Amount (Min 500)">
            <button class="action-btn" onclick="submitDeposit()">Deposit via USSD Push</button>
            <p id="deposit-status" style="font-size: 13px; margin-top: 10px; text-align: center;"></p>
        </div>
    </div>

    <!-- Tab 3: Withdrawal Section -->
    <div id="tab-withdraw" class="tab-content">
        <div class="card">
            <h3>Mobile Money Withdrawal</h3>
            <input type="text" id="withdraw-phone" placeholder="Phone (e.g. 256771234567)">
            <input type="number" id="withdraw-amount" placeholder="Amount to Withdraw">
            <button class="action-btn" onclick="alert('Withdrawal request submitted.')">Request Withdrawal</button>
        </div>
    </div>
</div>

<script>
function switchTab(tabName) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.navbar button').forEach(el => el.classList.remove('active'));
    
    document.getElementById('tab-' + tabName).classList.add('active');
    document.getElementById('btn-' + tabName).classList.add('active');
}

async function submitDeposit() {
    const phone = document.getElementById('deposit-phone').value;
    const network = document.getElementById('deposit-network').value;
    const amount = document.getElementById('deposit-amount').value;
    const statusEl = document.getElementById('deposit-status');

    if (!phone || !amount) {
        statusEl.style.color = '#ef4444';
        statusEl.innerText = 'Please fill in all fields.';
        return;
    }

    statusEl.style.color = '#38bdf8';
    statusEl.innerText = 'Sending USSD prompt to phone...';

    try {
        const response = await fetch('/api/deposit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone, network, amount })
        });
        const result = await response.json();

        if (result.success) {
            statusEl.style.color = '#22c55e';
            statusEl.innerText = result.message;
        } else {
            statusEl.style.color = '#ef4444';
            statusEl.innerText = 'Error: ' + result.error;
        }
    } catch (err) {
        statusEl.style.color = '#ef4444';
        statusEl.innerText = 'Network error connecting to backend.';
    }
}
</script>

</body>
</html>
